# ---- Sarvam AI (required for generated answers) ----
# Get a key from the Sarvam dashboard. SARVAM_API_KEY also works as the name.
# Keep the key server-side only: the frontend must never receive it (no VITE_ prefixed secret).
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_API_KEY=
LLM_MODEL=sarvam-105b
# sarvam-105b is a reasoning model: keep max tokens generous or answers can come back empty.
# It can spend 6-8k reasoning tokens before the first visible token, so small budgets yield
# finish_reason=length with no text; sarvam.chat raises rather than returning an empty answer.
LLM_MAX_TOKENS=12000
LLM_TIMEOUT_SECONDS=300
LLM_RETRIES=2

# ---- Sarvam speech (Saaras STT / Bulbul TTS) ----
# SARVAM_BASE_URL is the API root; STT and TTS hang off it directly. Chat uses LLM_BASE_URL
# (or SARVAM_CHAT_BASE_URL), because the root without /v1 answers HTTP 404.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_CHAT_BASE_URL=https://api.sarvam.ai/v1
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TIMEOUT_SECONDS=300

# ---- Retrieval ----
RETRIEVAL_LIMIT=5
RETRIEVAL_MIN_SCORE=1.0
# KB_PATH=app/data/knowledge_base.json

# ---- API protection (recommended before any public deployment) ----
APP_ENV=development
# If set, every /ask, /explain, /translate, /speech, /llm/check call must send header: X-API-Key: <value>
API_KEY=
RATE_LIMIT_PER_MINUTE=30
# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API.
# Replace these with the exact deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- BHASHINI (optional; translation/TTS support depends on pipeline account) ----
# Translation accepts en/hi/pa pairs; TTS accepts hi/pa when enabled by the pipeline.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# Newer getModelsPipeline responses no longer carry pipelineInferenceAPIEndPoint, so the
# inference host has to be configured when the pipeline response omits a callback URL.
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_TIMEOUT_SECONDS=20

# ---- Workstream E — Financial Intelligence Engine -----------------------
# Sarvam key is shared with LLM_API_KEY above (SARVAM_API_KEY is an alias).
# No additional API keys are required for Workstream E.

# Configurable debt pressure thresholds (fraction of income, e.g. 0.35 = 35%)
# Adjust these based on local lending norms if needed.
DEBT_WARNING_THRESHOLD=0.35
DEBT_HIGH_THRESHOLD=0.50
