# LUMO API - environment variable NAMES only. Never commit real values. Never put these in frontend code.

# Ordered, comma-separated list of GOVERNMENT-BACKED providers to try. Allowed: bharatgen, sarvam.
# Anything else is rejected at start-up. The deterministic demo fallback is always the last resort.
LUMO_LLM_PROVIDERS=bharatgen,sarvam
LUMO_LLM_TIMEOUT_SECONDS=30
LUMO_LLM_MAX_ATTEMPTS=2

# --- BharatGen (government-funded; open weights). Self-host with vLLM, then point at it:
#     vllm serve bharatgenai/Param-1-2.9B-Instruct --trust-remote-code --port 8000
BHARATGEN_BASE_URL=
BHARATGEN_MODEL=bharatgenai/Param-1-2.9B-Instruct
BHARATGEN_API_KEY=
BHARATGEN_JSON_MODE=false

# --- Sarvam (selected by the Government of India under the IndiaAI Mission). Verify names at docs.sarvam.ai
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-30b
SARVAM_AUTH_HEADER=api-subscription-key
SARVAM_JSON_MODE=false
